# Copy to .env next to compose.yaml and fill in your Stripe credentials.
# Postgres user, database, and password default to driftless; set
# POSTGRES_USER, POSTGRES_DB, or POSTGRES_PASSWORD here to override.

# Restricted read-only key (rk_...) recommended; driftless doctor lists
# the exact scopes to grant.
DRIFTLESS_STRIPE_API_KEY=rk_test_...
DRIFTLESS_STRIPE_WEBHOOK_SECRET=whsec_...
